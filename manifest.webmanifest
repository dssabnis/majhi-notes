{
  "name": "माझी नोट्स",
  "short_name": "माझी नोट्स",
  "description": "तुमच्या Google Drive मध्ये साठवणारे, ऑफलाइन चालणारे नोट्स अ‍ॅप",
  "lang": "mr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f4ef",
  "theme_color": "#2f5d50",
  "categories": ["productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "audio/*", "video/*", "application/pdf", "text/plain"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "नवीन नोट", "url": "./?new=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
